{
  "name": "daily-diet-api",
  "version": "1.0.0",
  "description": "Daily Diet API — Fastify + TypeScript + Knex + PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx ./node_modules/knex/bin/cli.js migrate:latest --knexfile src/db/knex.ts",
    "migrate:rollback": "tsx ./node_modules/knex/bin/cli.js migrate:rollback --knexfile src/db/knex.ts",
    "migrate:make": "tsx ./node_modules/knex/bin/cli.js migrate:make --knexfile src/db/knex.ts",
    "seed": "tsx ./node_modules/knex/bin/cli.js seed:run --knexfile src/db/knex.ts",
    "seed:make": "tsx ./node_modules/knex/bin/cli.js seed:make --knexfile src/db/knex.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.7.0",
    "@scalar/fastify-api-reference": "^1.58.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "knex": "^3.2.10",
    "pg": "^8.21.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.3.0"
}
